# Overlay for the Bluetooth Low Energy build: NimBLE peripheral that serves the
# Environmental Sensing service. Only advertises during the wake window; no calendar data.
CONFIG_DESK_BLE_ENABLE=y
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_BLUEDROID_ENABLED=n
CONFIG_BT_CLASSIC_ENABLED=n
CONFIG_BTDM_CTRL_MODE_BLE_ONLY=y
# NimBLE needs about 176 bytes more IRAM than the default build has: place app code in flash sections.
CONFIG_APP_BUILD_USE_FLASH_SECTIONS=y
