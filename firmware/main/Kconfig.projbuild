menu "LifeOS Desk Node"
    choice DESK_DISPLAY_INTERFACE
        prompt "SSD1306 display interface"
        default DESK_DISPLAY_SPI
        config DESK_DISPLAY_SPI
            bool "4-wire SPI module (revision 2 J4)"
        config DESK_DISPLAY_I2C
            bool "Legacy I2C module (revision 1 / J2)"
    endchoice
    config DESK_WIFI_SSID
        string "Wi-Fi SSID"
        default ""
    config DESK_WIFI_PASSWORD
        string "Wi-Fi password (local build only)"
        default ""
    config DESK_API_URL
        string "Desk API origin (HTTPS; no trailing slash)"
        default "https://desk.example.invalid"
    config DESK_API_TOKEN
        string "Desk API device token (local build only)"
        default ""
    config DESK_ALLOW_HTTP
        bool "Allow unencrypted HTTP for isolated development"
        default n
    config DESK_UPDATE_SECONDS
        int "Deep sleep interval in seconds"
        range 60 86400
        default 300
    config DESK_WIFI_TIMEOUT_SECONDS
        int "Wi-Fi connection deadline"
        range 5 60
        default 15
    config DESK_SNTP_SERVER
        string "SNTP server"
        default "pool.ntp.org"
endmenu
