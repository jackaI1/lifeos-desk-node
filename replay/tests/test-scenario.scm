(use-modules (desk scenario) (srfi srfi-64))
(test-begin "scenario")
(define runner (test-runner-current))
(test-equal "known sensor vector" '("S 6666938000a2")
  (compile-scenario '(scenario (sample 25000 50000))))
(test-equal "extreme vector" '("S 000081ffffac")
  (compile-scenario '(scenario (sample -45000 100000))))
(test-equal "maximum temperature" '("S ffffac000081")
  (compile-scenario '(scenario (sample 130000 0))))
(test-equal "corrupt temperature CRC" '("S 6666928000a2")
  (compile-scenario '(scenario (fault 25000 50000))))
(test-equal "nested order" '("S 6666938000a2" "U" "U" "S 6666938000a2" "U" "U")
  (compile-scenario '(scenario (repeat 2 (sample 25000 50000) (repeat 2 (upload))))))
(test-equal "wire format" "DESK_REPLAY_V1\nU\n"
  (call-with-output-string (lambda (p) (write-scenario '(scenario (upload)) p))))
(test-equal "maximum expansion" 4096
  (length (compile-scenario '(scenario (repeat 4096 (upload))))))
(for-each
 (lambda (bad) (test-error (object->string bad) #t (compile-scenario bad)))
 '(() (scenario) (other (upload)) (scenario . x)
   (scenario (sample -45001 0)) (scenario (sample 130001 0))
   (scenario (sample 0 -1)) (scenario (sample 0 100001))
   (scenario (sample 1.5 50)) (scenario (sample 1 1.0))
   (scenario (sample 1)) (scenario (sample 1 2 3))
   (scenario (upload 1)) (scenario (repeat 0 (upload)))
   (scenario (repeat -1 (upload))) (scenario (repeat 2.0 (upload)))
   (scenario (repeat 4097 (upload))) (scenario (repeat 2))
   (scenario (repeat 4096 (upload) (upload)))
   (scenario (repeat 4096 (upload)) (upload))
   (scenario (system "echo should-not-execute")) (scenario 42)
   (scenario (sample . 4))))
(define (nest n) (if (= n 0) '(upload) (list 'repeat 1 (nest (- n 1)))))
(test-equal "eight nested repeats" '("U") (compile-scenario (list 'scenario (nest 8))))
(test-error "nine nested repeats" #t (compile-scenario (list 'scenario (nest 9))))
(test-end "scenario")
(exit (if (zero? (test-runner-fail-count runner)) 0 1))
