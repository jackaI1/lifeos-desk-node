{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "strict": true, "esModuleInterop": true, "resolveJsonModule": true,
    "skipLibCheck": true, "lib": ["ES2022", "DOM"], "types": ["node", "vite/client"]
  },
  "include": ["src/**/*.ts", "src/**/*.vue", "shared/**/*.ts", "electron/**/*.ts", "tests/**/*.ts", "*.config.ts"]
}
